{
    "name": "charm/sort",
    "description": "Stable, fast sorting for PHP with a small object API: a Sorter configured once, with key functions, per-column order and locale-aware collation.",
    "type": "library",
    "license": "MIT",
    "keywords": ["sort", "sorting", "stable sort", "collation", "multisort"],
    "authors": [
        {
            "name": "Frode Børli",
            "email": "frode@ennerd.com"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "ext-intl": "Locale-aware sorting with Sorter::collated()"
    },
    "autoload": {
        "psr-4": {
            "Charm\\Sort\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Charm\\Sort\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
