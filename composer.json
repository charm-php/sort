{
    "name": "charm/sort",
    "description": "Stable, fast sorting for PHP with a small object API: a Sorter configured once, with a comparison closure or a derived sort key, and descending order.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sort",
        "sorting",
        "stable sort",
        "usort",
        "ksort"
    ],
    "authors": [
        {
            "name": "Frode Børli",
            "email": "frode@ennerd.com"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "ext-intl": "Locale-aware sorting with Sorter::collated()"
    },
    "autoload": {
        "psr-4": {
            "Charm\\Sort\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Charm\\Sort\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit",
        "generate": "bin/generate",
        "bench": [
            "Composer\\Config::disableProcessTimeout",
            "bench/run.sh"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the test suite",
        "generate": "Regenerate src/Loops.php from bin/*.tpl",
        "bench": "Benchmark against native sort(), with and without the JIT"
    }
}
