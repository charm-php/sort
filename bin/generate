#!/usr/bin/env php
<?php

declare(strict_types=1);

// Generates src/Loops.php: one specialised sort loop per (order, comparison) from bin/loop.tpl.
// The comparisons are expanded inline because a function or closure call per comparison costs
// more than the sort itself.
//
//   bin/generate            write src/Loops.php
//   bin/generate --stdout   print it (the test suite compares this with the committed file)
//
// Template tokens, all with parenthesis-free arguments:
//   @before(a, b)       key-only: a sorts strictly before b   (keys.tpl, and loop.tpl via @after)
//   @lt(a, ia, b, ib)   a sorts before b: by key, then by original offset
//   @gt(a, ia, b, ib)   a sorts after b
//   @after(a, b)        key of a sorts strictly after key of b (offsets not involved)
// The first argument may be an assignment, `$x = $a[$i]`; the value is then fetched once.

// kind => [function used to compare, or null for the PHP operators, doc text]
$kinds = [
    'Regular' => [null, 'PHP\'s standard comparison (also used for Numeric, on keys cast to float)'],
    'Binary' => ['strcmp', 'bytewise string comparison'],
    'BinaryCaseInsensitive' => ['strcasecmp', 'ASCII case-insensitive string comparison'],
    'Natural' => ['strnatcmp', 'natural order string comparison'],
    'NaturalCaseInsensitive' => ['strnatcasecmp', 'case-insensitive natural order string comparison'],
];

function expand(string $template, ?string $fn, bool $desc): string
{
    return preg_replace_callback('/@(lt|gt|after|before)\(([^()]*)\)/', function (array $m) use ($fn, $desc): string {
        $args = array_map('trim', explode(',', $m[2]));
        $first = $args[0];
        // "$x = $a[$i]": the first use fetches and assigns, later uses read the variable.
        if (preg_match('/^(\$\w+)\s*=\s*(.+)$/', $first, $f)) {
            [$first, $a] = ["($f[1] = $f[2])", $f[1]];
        } else {
            $a = $first;
        }
        // $before: the value comparison that means "sorts before" in this direction.
        $before = $desc ? '>' : '<';
        $after = $desc ? '<' : '>';
        if ($m[1] === 'after' || $m[1] === 'before') {
            [, $b] = $args;
            $op = $m[1] === 'after' ? $after : $before;
            return $fn === null ? "($a $op $b)" : "($fn($a, $b) $op 0)";
        }
        [, $ia, $b, $ib] = $args;
        $isLt = $m[1] === 'lt';
        $op = $isLt ? $before : $after;
        $offsets = $isLt ? '<' : '>';
        return $fn === null
            ? "($first $op $b || ($a == $b && $ia $offsets $ib))"
            : "((\$c = $fn($first, $b)) $op 0 || (\$c === 0 && $ia $offsets $ib))";
    }, $template);
}

$template = file_get_contents(__DIR__ . '/loop.tpl');
$out = <<<'PHP'
<?php

declare(strict_types=1);

// GENERATED by bin/generate from bin/loop.tpl. Do not edit; run bin/generate instead.

namespace Charm\Sort;

/**
 * The specialised sort loops used by Sorter: one per direction and comparison, with the
 * comparison written out inline. Generated code; not part of the public API.
 *
 * @internal
 */
final class Loops
{
    private function __construct()
    {
    }

    /**
     * The result of a comparison function that did not return an int, as usort() would read it
     * (a float is truncated), except that a bool is an error: it can't tell "equal" from "less".
     */
    private static function result(mixed $result): int
    {
        if (\is_bool($result) || \is_array($result) || \is_object($result)) {
            throw new \TypeError('The comparison function must return an int, ' . get_debug_type($result) . ' returned');
        }
        return (int) $result;
    }

PHP;
$methods = [];
foreach (['asc' => false, 'desc' => true] as $dir => $desc) {
    foreach ($kinds as $kind => [$fn, $doc]) {
        $text = str_replace(
            ['{{NAME}}', '{{DOC}}'],
            [$dir . $kind, ucfirst(($desc ? 'descending, ' : 'ascending, ') . $doc) . '.'],
            $template,
        );
        $methods[] = expand($text, $fn, $desc);
    }
}
// Sorting array keys: unique and totally ordered, so a plain quicksort without offsets.
// Int keys use the PHP operators; string keys compare bytewise (see Sorter::sortKeys()).
$keyTemplate = file_get_contents(__DIR__ . '/keys.tpl');
foreach (['asc' => false, 'desc' => true] as $dir => $desc) {
    foreach (['Int' => [null, 'integer keys'], 'String' => ['strcmp', 'string keys, bytewise']] as $kind => [$fn, $doc]) {
        $text = str_replace(
            ['{{NAME}}', '{{DOC}}'],
            ['keys' . ucfirst($dir) . $kind, ucfirst(($desc ? 'descending, ' : 'ascending, ') . $doc) . '.'],
            $keyTemplate,
        );
        $methods[] = expand($text, $fn, $desc);
    }
}
// Sorting with a user comparison function: a stable merge sort. The call is inlined as a statement,
// and the result is checked: usort() would only deprecate a bool, we reject it.
$mergeTemplate = file_get_contents(__DIR__ . '/merge.tpl');
foreach (['asc' => false, 'desc' => true] as $dir => $desc) {
    // The comparison function's result is negated for a descending sort: "left first" is then >= 0.
    $text = str_replace(
        ['{{NAME}}', '{{DOC}}', '{{GT}}', '{{LE}}'],
        ['merge' . ucfirst($dir), ucfirst($desc ? 'descending' : 'ascending') . ', with a comparison function.', $desc ? '< 0' : '> 0', $desc ? '>= 0' : '<= 0'],
        $mergeTemplate,
    );
    $text = preg_replace_callback('/^( *)@cmp\(([^,]*), ([^()]*)\)$/m', fn(array $m) => "$m[1]\$c = \$cmp($m[2], $m[3]);\n$m[1]if (!\\is_int(\$c)) {\n$m[1]    \$c = self::result(\$c);\n$m[1]}", $text);
    $methods[] = $text;
}
$out .= implode('', $methods) . "}\n";

if (in_array('--stdout', $argv, true)) {
    echo $out;
} else {
    file_put_contents(__DIR__ . '/../src/Loops.php', $out);
}
